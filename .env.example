# ============================================================================
# NovaPay Auth Service - Plantilla de variables de entorno
# ============================================================================
# Este archivo SÍ se commitea (es la plantilla). NO pongas valores reales aquí.
#
# Pasos para compañeros al clonar:
#   1) cp auth-service-novapay/.env.example  auth-service-novapay/.env
#   2) Rellena los valores reales
#   3) Nunca commitees .env — ya está en .gitignore
#
# Formato: ASP.NET Core traduce `Seccion__Llave` a `Seccion:Llave` en
# IConfiguration. Por eso doble guion bajo en lugar de dos puntos.
# ============================================================================

# --- Base de datos (misma instancia que Novapay-admin y Novapay-user) --------
# En Docker el host es el nombre del servicio declarado en docker-compose ("db")
# Para desarrollo local (dotnet run fuera de Docker) usa localhost y el puerto
# mapeado en docker-compose raíz: 5433 → 5432 interno.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=novapay_db;Username=postgres;Password=admin

# --- JWT ---------------------------------------------------------------------
JwtSettings__SecretKey=genera_una_clave_aleatoria_muy_larga_aqui_minimo_32_chars
JwtSettings__Issuer=NovaPayAuthService
JwtSettings__Audience=NovaPayServices
JwtSettings__ExpiryInMinutes=120

# --- SMTP (Gmail con App Password de 16 caracteres SIN espacios) ------------
# Cómo generar una App Password: https://myaccount.google.com/apppasswords
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=465
SmtpSettings__Username=tu-correo@gmail.com
SmtpSettings__Password=xxxxxxxxxxxxxxxx
SmtpSettings__FromEmail=tu-correo@gmail.com
SmtpSettings__FromName=NovaPay
SmtpSettings__Enabled=true
SmtpSettings__UseImplicitSsl=true

# --- Frontend URL ------------------------------------------------------------
AppSettings__FrontendUrl=http://localhost:5173
